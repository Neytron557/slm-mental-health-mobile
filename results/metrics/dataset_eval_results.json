  "metadata": {
    "base_dir": "models",
    "release_dir": "models/release_models",
    "seed": 42,
    "datasets": {
      "dreddit": {
        "display": "Dreaddit (stress)",
        "samples": 200,
        "source": "asmaab/dreaddit (test split)",
        "description": "Binary stress detection on Reddit posts."
      },
      "sdcnl": {
        "display": "SDCNL (suicide vs depression)",
        "samples": 200,
        "source": "jingjietan/sdcnl-suicide (test split)",
        "description": "Binary classification between suicidal intent and depression discussions."
      },
      "cssrs": {
        "display": "Reddit C-SSRS",
        "samples": 100,
        "source": "thisiskeithkwan/Reddit_C-SSRS (test split)",
        "description": "Multi-class suicide risk prediction using C-SSRS labels."
      },
      "emobench": {
        "display": "EmoBench (emotion understanding)",
        "samples": 200,
        "source": "SahandSab/EmoBench emotional_understanding split",
        "description": "Emotion understanding portion of EmoBench."
      },
      "goemotions": {
        "display": "GoEmotions (validation subset)",
        "samples": 200,
        "source": "google-research-datasets/go_emotions (validation split, simplified config)",
        "description": "Multi-class fine-grained emotion classification."
      }
    }
  },
